# ── Supabase ──────────────────────────────────────────────────
# Publiques : elles partent dans le navigateur, c'est voulu.
# Ce sont les regles d'acces par ligne (RLS) qui protegent les donnees.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET : acces total a la base, contourne toutes les regles.
# Uniquement cote serveur. Ne jamais prefixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend ────────────────────────────────────────────────────
# SECRET : permet d'envoyer des emails au nom du domaine.
RESEND_API_KEY=

# ── Chariow ───────────────────────────────────────────────────
# SECRET : sert a verifier que la notification de paiement vient bien de Chariow.
CHARIOW_WEBHOOK_SECRET=

# ── Divers ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://excelai.oscaraksanti.com
